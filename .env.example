# --- AI Configuration ---
# Optional. When set, the critic uses Gemini instead of the local model.
GEMINI_API_KEY=
# docker compose sets LLAMA_CPP_HOST and OLLAMA_HOST itself; these matter only outside compose.
LLAMA_CPP_HOST=http://localhost:8080
# Only if you run Ollama yourself (docker compose does not).
# OLLAMA_HOST=http://ollama:11434

# --- Market Data & Execution (Polymarket) ---
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=

# --- Market Data & Execution (Kalshi) ---
KALSHI_API_KEY=
KALSHI_SECRET=

# --- Market Data & Execution (Alpaca) ---
ALPACA_API_KEY=
ALPACA_SECRET=

# --- Infrastructure ---
DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/polymarket
REDIS_URL=redis://redis:6379/0

# --- App Settings ---
SECRET_KEY=generate_a_secure_random_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
LOG_LEVEL=INFO
DEBUG=False
