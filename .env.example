# --- AI Configuration ---
# Optional. When set, the critic uses Gemini instead of the local model.
GEMINI_API_KEY=
# Optional. Gemini model for the critic; defaults to gemini-flash-latest
# (the newest Flash release). Pin a version for reproducible critiques.
GEMINI_MODEL=
# docker compose sets LLAMA_CPP_HOST and OLLAMA_HOST itself; these matter only outside compose.
LLAMA_CPP_HOST=http://localhost:8080
# Only if you run Ollama yourself (docker compose does not).
# OLLAMA_HOST=http://ollama:11434

# --- Market Data & Execution (Polymarket) ---
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=

# --- Market Data & Execution (Kalshi) ---
KALSHI_API_KEY=
KALSHI_SECRET=

# --- Market Data & Execution (Alpaca) ---
# Server-side only: the dashboard reads the account through the backend.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Paper trading by default; https://api.alpaca.markets places real orders.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Infrastructure ---
DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/polymarket
REDIS_URL=redis://redis:6379/0

# --- App Settings ---
# Signs sign-in tokens; must be long, random and private. run.sh fills it in.
# Left empty, the backend uses a random key and sign-ins end when it restarts.
SECRET_KEY=
# How long a sign-in lasts.
ACCESS_TOKEN_EXPIRE_MINUTES=1440
LOG_LEVEL=INFO
DEBUG=False
